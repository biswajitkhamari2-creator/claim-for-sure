DB_HOST=127.0.0.1
DB_NAME=claimforsure
DB_USER=root
DB_PASS=
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MIN_32_CHARS
APP_URL=https://www.claimforsure.in
SMTP_HOST=smtp.hostinger.com
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_mailbox_password
SMTP_PORT=465
MAIL_FROM=no-reply@yourdomain.com

# APP_DEBUG=1 returns raw error messages to clients (local development only).
APP_DEBUG=0
# SMS OTP sign-in (MSG91). Template must be a DLT-approved OTP template using ##OTP##.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# OTP_TEST_MODE=1 skips the SMS and returns the code in the API response (local/staging only).
OTP_TEST_MODE=0
